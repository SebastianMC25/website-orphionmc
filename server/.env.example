# ==========================================
# OrphionMC Server Configuration
# ==========================================

PORT=3000
DOMAIN=orphionmc.net
NODE_ENV=production
COOKIE_SECURE=true
SESSION_SECRET=cambiar_por_una_clave_secreta_segura
MINECRAFT_API_KEY=generar_clave_segura_para_el_plugin

# ==========================================
# Discord OAuth2 Configuration
# Obtener en https://discord.com/developers/applications
# ==========================================
DISCORD_CLIENT_ID=tu_client_id_aqui
DISCORD_CLIENT_SECRET=tu_client_secret_aqui
DISCORD_REDIRECT_URI=https://api.orphionmc.net/auth/discord/callback

# Para desarrollo local:
# DOMAIN=OrphionMC.local
# COOKIE_SECURE=false
# DISCORD_REDIRECT_URI=http://api.OrphionMC.local:3000/auth/discord/callback
